@using MovieReviews.Data
@using MovieReviews.Services
@inject GuideService GuideService

<div>
    <div class="shape-help-input">
        @ChildContent
        <button type="button" class="shape-help-button" @onclick="Toggle"
                title="Shape vocabulary / راهنمای فرم" aria-label="Shape vocabulary / راهنمای فرم"
                aria-expanded="@(_open ? "true" : "false")" aria-controls="@_panelId">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v6" />
                <circle cx="12" cy="7.5" r="1" fill="currentColor" stroke="none" />
            </svg>
        </button>
    </div>
    @if (_open)
    {
        <div id="@_panelId" class="border rounded p-3 bg-light small mt-1">
            <p class="mb-2">Use shape words in the quality or override field. Size is separate; <strong>soft</strong> describes texture, and <strong>pretty</strong> is an opinion.</p>
            <p class="mb-2">Example: <strong>rounded, fuller at the bottom</strong>. For افتاده, try <strong>lower-hanging</strong> or <strong>pendulous</strong>.</p>
            @if (_loading)
            {
                <p role="status" class="mb-0">Loading shape words…</p>
            }
            else if (_error)
            {
                <p role="alert" class="mb-0">Could not load the guide. <button type="button" class="btn btn-link btn-sm" @onclick="Load">Try again</button></p>
            }
            else if (_items.Count == 0)
            {
                <p class="mb-0">Add shape words in the <a href="/moviereview/guide" target="_blank" rel="noopener">Guide</a> under Breast shape / appearance.</p>
            }
            else
            {
                <dl class="mb-0">
                    @foreach (var item in _items)
                    {
                        <dt @key="item.Id" class="mt-2">@item.Text</dt>
                        <dd class="mb-1">@item.Description</dd>
                    }
                </dl>
            }
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _panelId = $"shape-help-{Guid.NewGuid():N}";
    private bool _open;
    private bool _loading;
    private bool _loaded;
    private bool _error;
    private List<GuideItem> _items = [];

    private async Task Toggle()
    {
        _open = !_open;
        if (_open && !_loaded && !_loading) await Load();
    }

    private async Task Load()
    {
        if (_loading) return;
        _loading = true;
        _error = false;
        try
        {
            var sections = await GuideService.GetAllAsync();
            _items = sections.Where(s => string.Equals(s.Name, "Breast shape / appearance", StringComparison.OrdinalIgnoreCase))
                .SelectMany(s => s.Items).OrderBy(i => i.SortOrder).ToList();
            _loaded = true;
        }
        catch
        {
            _error = true;
        }
        finally { _loading = false; }
    }
}
