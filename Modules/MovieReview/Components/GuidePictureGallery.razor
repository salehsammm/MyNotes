@using MovieReviews.Data
@using MovieReviews.Services
@implements IAsyncDisposable
@inject GuideService GuideService
@inject IJSRuntime JS
@inject ILogger<GuidePictureGallery> Logger

<button type="button" class="btn btn-sm btn-outline-secondary guide-pictures-button"
        aria-label="Pictures for @SectionName" aria-haspopup="dialog" @onclick="Open" disabled="@(_busy || _loading)">Pictures</button>

<dialog @ref="_dialog" class="guide-gallery" aria-labelledby="@_headingId" @onclose="OnClosed">
    <div class="gallery-heading">
        <div><div class="eyebrow">VOCABULARY PICTURES</div><h2 id="@_headingId">@SectionName</h2></div>
        <button type="button" class="btn btn-outline-secondary" @onclick="Close" aria-label="Close pictures">Close</button>
    </div>
    @if (_loading)
    {
        <p role="status">Loading pictures…</p>
    }
    else if (_pictures.Count == 0)
    {
        <p class="gallery-empty">No pictures yet. Add pictures for this group below.</p>
    }
    else
    {
        var picture = _pictures[_index];
        <figure class="gallery-slide">
            <img @key="picture.Id" src="@PictureUrl(picture.Id)" alt="@picture.FileName" />
            <figcaption>@picture.FileName</figcaption>
        </figure>
        <div class="gallery-controls">
            <button type="button" class="btn btn-outline-secondary" @onclick="Previous" disabled="@(_pictures.Count < 2)">← Previous</button>
            <span role="status" aria-live="polite">@(_index + 1) / @_pictures.Count</span>
            <button type="button" class="btn btn-outline-secondary" @onclick="Next" disabled="@(_pictures.Count < 2)">Next →</button>
        </div>
        <div class="gallery-thumbnails" aria-label="Choose a picture">
            @for (var i = 0; i < _pictures.Count; i++)
            {
                var position = i;
                var thumbnail = _pictures[i];
                <button type="button" class="@(_index == i ? "selected" : "")" @onclick="() => _index = position"
                        aria-label="Show picture @(i + 1): @thumbnail.FileName" aria-pressed="@(_index == i)">
                    <img src="@PictureUrl(thumbnail.Id)" alt="" loading="lazy" />
                </button>
            }
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DeleteCurrent" disabled="@_busy">Delete this picture</button>
    }
    <div class="gallery-upload">
        <label for="@_uploadId">Add pictures</label>
        <InputFile id="@_uploadId" OnChange="Upload" multiple accept="image/jpeg,image/png,image/gif,image/webp" disabled="@(_busy || _loading)" />
        <small>JPEG, PNG, GIF or WebP. Up to 10 pictures at a time, 10 MB each.</small>
    </div>
    @if (_busy) { <p role="status">Saving pictures…</p> }
    @if (!string.IsNullOrEmpty(_message)) { <p role="status">@_message</p> }
    @if (!string.IsNullOrEmpty(_error)) { <p class="text-danger" role="alert">@_error</p> }
</dialog>

@code {
    [Parameter] public int SectionId { get; set; }
    [Parameter] public string SectionName { get; set; } = "";
    private readonly string _headingId = $"gallery-{Guid.NewGuid():N}";
    private readonly string _uploadId = $"upload-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private List<GuidePictureInfo> _pictures = [];
    private int _index;
    private bool _loading, _busy, _showPending;
    private string? _message, _error;
    private static string PictureUrl(int id) => $"/moviereview/guide/pictures/{id}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_showPending) return;
        _showPending = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/moviereview/guide-gallery.js");
        await _module.InvokeVoidAsync("show", _dialog);
    }

    private async Task Open()
    {
        _error = _message = null;
        _index = 0;
        _loading = _showPending = true;
        try { _pictures = await GuideService.GetPicturesAsync(SectionId); }
        catch (Exception ex) { ReportError(ex, "Could not load pictures. Close and try again."); }
        finally { _loading = false; }
    }

    private async Task Close()
    {
        if (_module is not null) await _module.InvokeVoidAsync("close", _dialog);
    }

    private void OnClosed() { _pictures = []; _index = 0; }
    private void Previous() => _index = (_index + _pictures.Count - 1) % _pictures.Count;
    private void Next() => _index = (_index + 1) % _pictures.Count;

    private async Task Upload(InputFileChangeEventArgs args)
    {
        _busy = true;
        _error = _message = null;
        var added = 0;
        try
        {
            foreach (var file in args.GetMultipleFiles(10))
            {
                if (file.Size == 0 || file.Size > GuideService.MaxPictureBytes)
                    throw new ArgumentException($"{file.Name}: each picture must be between 1 byte and 10 MB.");
                await using var input = file.OpenReadStream(GuideService.MaxPictureBytes);
                using var buffer = new MemoryStream();
                await input.CopyToAsync(buffer);
                await GuideService.AddPictureAsync(SectionId, file.Name, buffer.ToArray());
                added++;
            }
        }
        catch (Exception ex) { ReportError(ex, "Could not finish uploading. Choose up to 10 pictures and try again."); }
        finally
        {
            try
            {
                _pictures = await GuideService.GetPicturesAsync(SectionId);
                _index = Math.Max(0, _pictures.Count - 1);
            }
            catch (Exception ex) { ReportError(ex, "Could not refresh pictures. Close and try again."); }
            if (added > 0) _message = $"Added {added} picture(s).";
            _busy = false;
        }
    }

    private async Task DeleteCurrent()
    {
        if (_pictures.Count == 0 || _busy) return;
        var picture = _pictures[_index];
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete picture \"{picture.FileName}\"?")) return;
        _busy = true;
        _error = _message = null;
        try
        {
            await GuideService.DeletePictureAsync(SectionId, picture.Id);
            _pictures = await GuideService.GetPicturesAsync(SectionId);
            _index = Math.Max(0, Math.Min(_index, _pictures.Count - 1));
            _message = "Picture deleted.";
        }
        catch (Exception ex) { ReportError(ex, "Could not delete this picture. Try again."); }
        finally { _busy = false; }
    }

    private void ReportError(Exception ex, string message)
    {
        Logger.LogWarning(ex, "Vocabulary picture operation failed for section {SectionId}", SectionId);
        _error = ex is ArgumentException or UnauthorizedAccessException ? ex.Message : message;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("close", _dialog); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
